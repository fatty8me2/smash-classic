{
  // BattleShip netplay lobby: room codes, endpoint exchange for UDP hole
  // punching, and a WebSocket relay fallback. One Durable Object per room.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smash-netplay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  // RetroHub admin: every user is auto-friended with this account once (src/friends.js autoLinkAdmin)
  "vars": { "ADMIN_UID": "4ooju7u7o3zy67l2qqaotuj5n4" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "NetplayRoom" },
      { "name": "HUB_ROOMS", "class_name": "HubRoom" },
      { "name": "USER_HUBS", "class_name": "UserHub" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "LINK_BOXES", "class_name": "LinkBox" }
    ]
  },
  // Optional cloud saves (src/saves.js). Without this binding every /saves route answers 503 and nothing else
  // changes. Enable it ONLY after R2 is turned on for the account and the bucket exists, otherwise `wrangler
  // deploy` fails. Steps: see docs/CLOUD_SAVES.md in RetroHub. Then uncomment:
  // "r2_buckets": [{ "binding": "SAVES", "bucket_name": "retrohub-saves" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NetplayRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["HubRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["UserHub", "Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["LinkBox"] }
  ]
}
