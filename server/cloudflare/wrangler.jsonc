{
  // BattleShip netplay lobby: room codes, endpoint exchange for UDP hole
  // punching, and a WebSocket relay fallback. One Durable Object per room.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smash-netplay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  // RetroHub admin: every user is auto-friended with this account once (src/friends.js autoLinkAdmin)
  // Cloud saves v2 rollout switches (docs/CLOUD_SAVES_V2.md section 7.6; all optional, these are the defaults):
  //   SAVES_V2 "0" turns every /saves/v2 route off (v1 keeps working); ACCOUNT_CAP / PROT_CAP in bytes (50 MB / 20 MB);
  //   POOL_TIGHT / POOL_FULL = fractions of the global 7 GB storage guard at which the large pools shrink / stop.
  "vars": { "ADMIN_UID": "4ooju7u7o3zy67l2qqaotuj5n4", "SAVES_V2": "1", "ACCOUNT_CAP": "52428800", "PROT_CAP": "20971520", "POOL_TIGHT": "0.7", "POOL_FULL": "0.9" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "NetplayRoom" },
      { "name": "HUB_ROOMS", "class_name": "HubRoom" },
      { "name": "USER_HUBS", "class_name": "UserHub" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "LINK_BOXES", "class_name": "LinkBox" },
      // Global R2 free-tier budget guard + saves index (src/r2budget.js). Free-plan SQLite class.
      { "name": "R2_BUDGET", "class_name": "R2Budget" },
      // Daily operational counters for /admin/stats (src/stats.js). Free-plan SQLite class.
      { "name": "OPS_STATS", "class_name": "OpsStats" },
      // Global daily request budget / relay cost guard (src/reqbudget.js). Free-plan SQLite class.
      { "name": "REQ_BUDGET", "class_name": "ReqBudget" }
    ]
  },
  // Optional cloud saves (src/saves.js). Without this binding every /saves route answers 503 and nothing else
  // changes. Enable it ONLY after R2 is turned on for the account and the bucket exists, otherwise `wrangler
  // deploy` fails. Steps: see docs/CLOUD_SAVES.md in RetroHub. Then uncomment:
  "r2_buckets": [{ "binding": "SAVES", "bucket_name": "retrohub-saves" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NetplayRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["HubRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["UserHub", "Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["LinkBox"] },
    { "tag": "v5", "new_sqlite_classes": ["R2Budget"] },
    { "tag": "v6", "new_sqlite_classes": ["OpsStats"] },
    { "tag": "v7", "new_sqlite_classes": ["ReqBudget"] }
  ]
}
